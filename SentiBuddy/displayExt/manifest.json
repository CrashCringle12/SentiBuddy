{
  "manifest_version": 3,
  "name": "Sentinel Incidents++",
  "version": "1.2.0",
  "description": "Watches ARM batch calls and shows a 100-row Sentinel incident queue with filters.",
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": ["https://management.azure.com/*"],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://portal.azure.com/*", "<all_urls>"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
