{
    "name": "Senti Buddy",
    "version": "5.0",
    "description": "Browser Extension to enable Filtering & Desktop Notifications for Sentinel — Toggle with ALT+A . ALT+C to access config.",
    "author": {
        "email": "cringlebox@gmail.com"
    },
    "options_ui": {
      "page": "options.html",
      "open_in_tab": true
    },
    "manifest_version": 3,
    "permissions": [
      "activeTab",
      "notifications",
      "tabs",
      "webRequest",
      "clipboardRead",
      "storage",
      "favicon",
      "idle",
      "alarms"
    ],
    "action": {
      "default_popup": "popup.html"
     },
    "commands": {
      "toggle-queue-filtering": {
        "description": "Initiate Queue Filtering",
        "suggested_key": {
          "default": "Alt+A",
          "mac": "Command+Shift+A"
        }
      },
      "search-ip": {
        "description": "Search an IP",
        "suggested_key": {
          "default": "Alt+P",
          "mac": "Command+Shift+P"
        }
      },
      "search-hash": {
        "description": "Search Hash",
        "suggested_key": {
          "default": "Alt+H",
          "mac": "Command+Shift+H"
        }
      },
      "open-config": {
        "description": "Open Config",
        "suggested_key": {
          "default": "Alt+C",
          "mac": "Command+Shift+C"
        }
      },
      "toggle-enhanced-queue": {
        "description": "Toggle the Enhanced Queue (Alt+Q also works on the portal page)"
      }
    },
  "host_permissions": [
    "https://management.azure.com/*",
    "https://portal.azure.com/*",
    "https://*.reactblade.portal.azure.net/*",
    "https://mto.security.microsoft.com/*",
     "https://security.microsoft.com/*"
  ],
    "content_scripts": [
      {
        "matches": [
          "https://portal.azure.com/*",
          "https://mto.security.microsoft.com/*",
          "https://security.microsoft.com/*",
          "https://api.abuseipdb.com/*",
          "https://www.virustotal.com/*",
          "https://api11.scamalytics.com/*"
        ],
        "css": ["css/core.css"],
        "js": ["core.js"],
        "run_at": "document_end",
        "all_frames": true
      },
      {
        "matches": ["https://portal.azure.com/*"],
        "css": ["enhanced-queue/panel.css", "playbooks/top.css", "incident-docs/top.css", "playbooks/frame.css", "comments/frame.css", "time-tracking/top.css"],
        "js": ["enhanced-queue/content.js", "playbooks/top.js", "incident-docs/top.js", "playbooks/frame.js", "comments/frame.js", "time-tracking/top.js"],
        "run_at": "document_start",
        "all_frames": false
      },
      {
        "matches": ["https://*.reactblade.portal.azure.net/*"],
        "css": ["playbooks/frame.css", "comments/frame.css", "logicapp/frame.css"],
        "js": ["playbooks/frame.js", "comments/frame.js", "logicapp/frame.js"],
        "run_at": "document_idle",
        "all_frames": true
      },
      {
        "matches": ["https://*.reactblade.portal.azure.net/*"],
        "js": ["logicapp/page.js"],
        "run_at": "document_idle",
        "all_frames": true,
        "world": "MAIN"
      }
    ],
    "background": {
      "service_worker": "service_worker.js"
    },
    "web_accessible_resources": [
        {
          "resources": [ "_favicon/*", "options.html", "popup.html"],
          "matches": ["https://mto.security.microsoft.com/*", "https://security.microsoft.com/*", "https://portal.azure.com/*","https://api.abuseipdb.com/*", "https://www.virustotal.com/*", "https://api11.scamalytics.com/*"],
          "extension_ids": ["*"]
        },
        {
          "resources": ["enhanced-queue/injected.js"],
          "matches": ["https://portal.azure.com/*"]
        },
        {
          "resources": ["icon.png"],
          "matches": ["https://*.reactblade.portal.azure.net/*", "https://portal.azure.com/*"]
        }
      ],
    "icons": {
      "16": "icon.png",
      "38": "icon.png",
      "48": "icon.png"
    }
  }